APP_DEBUG = false

# 应用
[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

# 数据库
[DATABASE]
TYPE = mysql
HOSTNAME = mysql
DATABASE = mkshop
USERNAME = root
PASSWORD = root
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = mks_

# Redis（注意：TP6 段名会拼进键名，段内不要再带 REDIS_ 前缀）
[REDIS]
HOSTNAME = redis
PORT = 6379
PASSWORD =
SELECT = 0

# MKSHOP 站点密钥（安装向导生成）
[MKS]
APP_KEY =
AUTH_KEY =
SIGN_KEY =
QUEUE_PREFIX = mks_queue
