APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = mysql
DATABASE = mkshop
USERNAME = root
PASSWORD = root
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = mks_

[REDIS]
REDIS_HOSTNAME = redis
PORT = 6379
REDIS_PASSWORD =
SELECT = 0

[MKS]
; 站点加密密钥（安装向导生成，替代原 kss.app_key）
APP_KEY =
; 开放 API 签名密钥（api/dockapi 对接用）
AUTH_KEY =
SIGN_KEY =
; 队列前缀
QUEUE_PREFIX = mks_queue
