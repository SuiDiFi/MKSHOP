{
    "name": "mkshop/mkshop",
    "description": "MKSHOP 虚拟商品电商系统",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^6.1.3",
        "topthink/think-multi-app": "^1.0",
        "topthink/think-orm": "^2.0",
        "topthink/think-queue": "^3.0",
        "topthink/think-swoole": "^4.0",
        "topthink/think-view": "^1.0",
        "firebase/php-jwt": "^6.10",
        "phpoffice/phpspreadsheet": "^1.29",
        "ext-json": "*",
        "ext-redis": "*",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "mks\\": "mks"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "topthink/think-installer": true
        },
        "policy": {
            "advisories": {
                "block": false,
                "ignore-id": ["PKSA-wpgp-v5cy-4kds", "PKSA-qzw1-yq5b-y8j5"]
            }
        }
    },
    "extra": {
        "think": {
            "services": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
