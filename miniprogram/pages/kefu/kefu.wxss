page { height: 100vh; display: flex; flex-direction: column; background: #f4f5f7; }
.status-bar { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 24rpx; background: #fff; border-bottom: 2rpx solid #f2f3f5; font-size: 24rpx; color: #909399; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #16a34a; }
.dot.off { background: #c0c4cc; }
.reopen { margin-left: auto; color: #1d6fe8; font-size: 26rpx; }
.chat { flex: 1; padding: 20rpx 24rpx; box-sizing: border-box; overflow: hidden; }
.msg { display: flex; align-items: flex-start; gap: 14rpx; margin-bottom: 24rpx; }
.msg.mine { flex-direction: row-reverse; }
.msg.sys-row { justify-content: center; }
.sys { background: rgba(0,0,0,.05); color: #909399; font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 20rpx; max-width: 86%; text-align: center; }
.avatar { width: 60rpx; height: 60rpx; border-radius: 50%; background: #1d6fe8; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; flex-shrink: 0; }
.msg.other .avatar { background: #16a34a; }
.bubble { max-width: 72%; background: #fff; border-radius: 16rpx; padding: 18rpx 24rpx; font-size: 28rpx; line-height: 1.55; word-break: break-all; }
.msg.mine .bubble { background: #1d6fe8; color: #fff; }
.composer { display: flex; gap: 16rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 2rpx solid #eee; }
.composer .input { flex: 1; }
.send { width: 140rpx; height: 84rpx; border-radius: 16rpx; background: #1d6fe8; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.send.off { background: #c9d4e3; }
