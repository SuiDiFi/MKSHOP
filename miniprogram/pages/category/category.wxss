.cate-wrap { display: flex; height: 100vh; }
.side { width: 176rpx; height: 100%; background: #f7f8fa; flex-shrink: 0; }
.side-item { padding: 30rpx 20rpx; font-size: 26rpx; color: #606266; text-align: center; }
.side-item.active { background: #fff; color: #1d6fe8; font-weight: 700; border-left: 6rpx solid #1d6fe8; }
.main { flex: 1; display: flex; flex-direction: column; height: 100%; }
.main .search { margin: 20rpx 20rpx 0; }
.main .search .ico { margin-right: 12rpx; }
.list { flex: 1; padding: 20rpx; box-sizing: border-box; overflow: hidden; }
.pager { display: flex; align-items: center; justify-content: center; gap: 28rpx; padding: 20rpx 0; }
.pg { font-size: 26rpx; color: #1d6fe8; }
.pg.off { color: #c0c4cc; }
