.tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 5; }
.tab { flex: 1; text-align: center; padding: 26rpx 0; font-size: 27rpx; color: #606266; }
.tab.active { color: #1d6fe8; font-weight: 700; border-bottom: 4rpx solid #1d6fe8; }
.order-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.order-card .status { font-size: 26rpx; color: #1d6fe8; }
.goods { display: flex; align-items: center; margin-top: 18rpx; gap: 18rpx; }
.goods .thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f6f7f9; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
.goods .thumb image { width: 100%; height: 100%; }
.goods .info { flex: 1; min-width: 0; }
.goods .name { font-size: 27rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.more { text-align: center; padding: 20rpx 0 40rpx; }
