page { background: #f4f5f7; font-size: 28rpx; color: #222; }
.wrap { padding: 20rpx 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-top: 20rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.muted { color: #909399; font-size: 24rpx; }
.price { color: #f0483e; font-weight: 700; }
.price .small { font-size: 22rpx; font-weight: 500; }
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 84rpx; border-radius: 42rpx; background: #1d6fe8; color: #fff;
  font-size: 30rpx; font-weight: 600;
}
.btn.block { width: 100%; }
.btn[disabled] { background: #c9d4e3; }
.btn.ghost { background: #eef4ff; color: #1d6fe8; }
.tag { display: inline-block; padding: 2rpx 10rpx; border-radius: 6rpx; font-size: 22rpx; background: #eef4ff; color: #1d6fe8; }
.tag.gray { background: #f2f3f5; color: #909399; }
.tag.red { background: #fff1f0; color: #f0483e; }
.tag.green { background: #eefaf0; color: #16a34a; }
.empty { text-align: center; color: #b0b3b8; padding: 100rpx 0; font-size: 26rpx; }
.empty .big { font-size: 60rpx; margin-bottom: 12rpx; }

.goods-row { display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx; }
.goods-row .thumb { width: 180rpx; height: 180rpx; flex-shrink: 0; border-radius: 12rpx; background: #f6f7f9; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.goods-row .thumb image { width: 100%; height: 100%; }
.goods-row .info { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.goods-row .name { font-size: 28rpx; font-weight: 600; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.goods-row .meta { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }

.search { background: #fff; border-radius: 40rpx; padding: 0 28rpx; height: 68rpx; display: flex; align-items: center; }
.search input { flex: 1; font-size: 26rpx; }

.field { margin-top: 20rpx; }
.field .label { font-size: 26rpx; color: #606266; margin-bottom: 10rpx; }
.input { height: 84rpx; border: 2rpx solid #e4e7ed; border-radius: 12rpx; padding: 0 24rpx; background: #fff; font-size: 28rpx; }
